# Tout est facultatif. Ces variables ne sont lues que côté serveur.
# Active un flux régional adsb.lol à la demande (quota et couverture variables).
ADS_B_ENABLED=false
ADS_B_API_KEY=
# AIS régional du détroit du Pas-de-Calais et de la Manche orientale.
AISSTREAM_API_KEY=
# Gemini : la clé suffit ; modèle facultatif (gemini-3.1-flash-lite par défaut).
GEMINI_API_KEY=
GEMINI_MODEL=
